<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <TextView android:id="@+id/week_number" android:layout_width="16dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="9sp" android:includeFontPadding="false" />
    <TextView android:id="@+id/d0" style="@style/WidgetDay" />
    <TextView android:id="@+id/d1" style="@style/WidgetDay" />
    <TextView android:id="@+id/d2" style="@style/WidgetDay" />
    <TextView android:id="@+id/d3" style="@style/WidgetDay" />
    <TextView android:id="@+id/d4" style="@style/WidgetDay" />
    <TextView android:id="@+id/d5" style="@style/WidgetDay" />
    <TextView android:id="@+id/d6" style="@style/WidgetDay" />
</LinearLayout>
