<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:paddingHorizontal="3dp" android:paddingVertical="3dp">
    <TextView android:id="@+id/agenda_day" android:layout_width="wrap_content" android:minWidth="24dp" android:maxWidth="37dp" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="#D3E4DA" android:maxLines="1" android:includeFontPadding="false" android:textSize="11sp" />
    <ImageView android:id="@+id/agenda_color" android:layout_width="3dp" android:layout_height="19dp" android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" android:src="@drawable/widget_bar" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FAFBF5" android:fontFamily="sans-serif-medium" android:singleLine="true"
            android:includeFontPadding="false" android:ellipsize="end" android:textSize="14sp" />
        <TextView android:id="@+id/agenda_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textColor="#C5DCD1" android:includeFontPadding="false" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
