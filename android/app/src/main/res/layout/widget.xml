<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface" android:padding="9dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="3dp" android:paddingEnd="1dp">
            <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="18sp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:includeFontPadding="false"
                android:ellipsize="end" android:textColor="@color/widget_ink" android:text="月历" />
            <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false" android:textColor="@color/widget_muted" />
        </LinearLayout>
        <ImageView android:id="@+id/prev" style="@style/WidgetControl"
            android:src="@drawable/ic_prev" android:contentDescription="上个月" />
        <ImageView android:id="@+id/next" style="@style/WidgetControl"
            android:src="@drawable/ic_next" android:contentDescription="下个月" />
        <ImageView android:id="@+id/add" style="@style/WidgetControl"
            android:src="@drawable/ic_plus" android:contentDescription="新增日程" />
        <ImageView android:id="@+id/setup" style="@style/WidgetControl"
            android:src="@drawable/ic_sliders" android:contentDescription="选择日历" />
    </LinearLayout>
    <LinearLayout android:id="@+id/items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="5dp" android:orientation="vertical" />
    <include layout="@layout/widget_focus" />
</LinearLayout>
