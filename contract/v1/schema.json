{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timepin:calendar:v1",
  "title": "TimePin calendar command v1",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "calendar": {
      "type": "object",
      "required": ["id", "ownerKind", "ownerId", "color"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "ownerKind": {"enum": ["person", "group"]},
        "ownerId": {"$ref": "#/$defs/id"},
        "color": {"$ref": "#/$defs/color"}
      },
      "additionalProperties": false
    },
    "span": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "start", "end"],
          "properties": {"kind": {"const": "date"}, "start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "start", "end", "zone"],
          "properties": {
            "kind": {"const": "timed"},
            "start": {"$ref": "#/$defs/timestamp"},
            "end": {"$ref": "#/$defs/timestamp"},
            "zone": {"type": "string", "minLength": 1, "maxLength": 120}
          },
          "additionalProperties": false
        }
      ]
    },
    "repeat": {
      "type": "object",
      "required": ["frequency", "interval"],
      "properties": {
        "frequency": {"enum": ["daily", "weekly", "monthly", "yearly"]},
        "interval": {"type": "integer", "minimum": 1, "maximum": 999},
        "until": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    },
    "exception": {
      "oneOf": [
        {
          "type": "object",
          "required": ["on", "cancel"],
          "properties": {"on": {"$ref": "#/$defs/date"}, "cancel": {"const": true}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["on", "move"],
          "properties": {"on": {"$ref": "#/$defs/date"}, "move": {"$ref": "#/$defs/span"}},
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "required": ["title", "span"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "span": {"$ref": "#/$defs/span"},
        "color": {"$ref": "#/$defs/color"},
        "participants": {"type": "array", "items": {"$ref": "#/$defs/id"}, "maxItems": 512, "uniqueItems": true},
        "repeat": {"$ref": "#/$defs/repeat"},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}, "maxItems": 366}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["id", "calendarId", "creatorId", "version", "deleted", "event"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "calendarId": {"$ref": "#/$defs/id"},
        "creatorId": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "deleted": {"type": "boolean"},
        "event": {"$ref": "#/$defs/event"}
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["start", "end", "zone"],
      "properties": {
        "start": {"$ref": "#/$defs/date"},
        "end": {"$ref": "#/$defs/date"},
        "participantId": {"$ref": "#/$defs/id"},
        "zone": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "externalId": {"$ref": "#/$defs/id"},
        "baseVersion": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "acceptCurrent": {"const": true},
        "event": {"$ref": "#/$defs/event"}
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": ["source", "rows"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}, "maxItems": 5000, "minItems": 1}
      },
      "additionalProperties": false
    },
    "request": {
      "oneOf": [
        {"$ref": "#/$defs/op.event.get"},
        {"$ref": "#/$defs/op.event.create"},
        {"$ref": "#/$defs/op.event.replace"},
        {"$ref": "#/$defs/op.event.delete"},
        {"$ref": "#/$defs/op.event.query"},
        {"$ref": "#/$defs/op.import.preview"},
        {"$ref": "#/$defs/op.import.commit"},
        {"$ref": "#/$defs/op.import.undoPreview"},
        {"$ref": "#/$defs/op.import.undo"}
      ]
    },
    "op.event.get": {
      "description": "按稳定编号获取事件和当前版本，包括删除标记。",
      "x-timepin": {"scope": "calendar", "access": "read", "result": "record"},
      "type": "object",
      "required": ["v", "op", "calendarId", "eventId"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "event.get"},
        "calendarId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "op.event.create": {
      "description": "在当前日历中新建事件，创建者来自调用身份。用户只指定日期时默认创建全天事件（span.kind=date，end 为最后一天的次日）；用户指定具体时刻时使用 timed。",
      "x-timepin": {"scope": "calendar", "access": "create", "result": "record"},
      "type": "object",
      "required": ["v", "op", "calendarId", "operationId", "eventId", "event"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "event.create"},
        "calendarId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"},
        "event": {"$ref": "#/$defs/event"}
      },
      "additionalProperties": false
    },
    "op.event.replace": {
      "description": "按基准版本替换完整的事件内容。",
      "x-timepin": {"scope": "calendar", "access": "edit-own-or-all", "result": "record"},
      "type": "object",
      "required": ["v", "op", "calendarId", "operationId", "eventId", "baseVersion", "event"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "event.replace"},
        "calendarId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"},
        "baseVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "event": {"$ref": "#/$defs/event"}
      },
      "additionalProperties": false
    },
    "op.event.delete": {
      "description": "按基准版本删除事件并保留带版本的标记。",
      "x-timepin": {"scope": "calendar", "access": "edit-own-or-all", "result": "record"},
      "type": "object",
      "required": ["v", "op", "calendarId", "operationId", "eventId", "baseVersion"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "event.delete"},
        "calendarId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"},
        "baseVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    },
    "op.event.query": {
      "description": "展开时间窗口内的日程，可按参与人筛选。",
      "x-timepin": {"scope": "calendar", "access": "read", "result": "occurrences"},
      "type": "object",
      "required": ["v", "op", "calendarId", "window"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "event.query"},
        "calendarId": {"$ref": "#/$defs/id"},
        "window": {"$ref": "#/$defs/window"}
      },
      "additionalProperties": false
    },
    "op.import.preview": {
      "description": "预览导入的逐行结果和基准版本。",
      "x-timepin": {"scope": "calendar", "access": "import-per-row", "result": "rows"},
      "type": "object",
      "required": ["v", "op", "calendarId", "operationId", "batch"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "import.preview"},
        "calendarId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "batch": {"$ref": "#/$defs/batch"}
      },
      "additionalProperties": false
    },
    "op.import.commit": {
      "description": "提交导入并返回批次编号与逐行结果。",
      "x-timepin": {"scope": "calendar", "access": "import-per-row", "result": "rows"},
      "type": "object",
      "required": ["v", "op", "calendarId", "operationId", "batch"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "import.commit"},
        "calendarId": {"$ref": "#/$defs/id"},
        "operationId": {"$ref": "#/$defs/id"},
        "batch": {"$ref": "#/$defs/batch"}
      },
      "additionalProperties": false
    },
    "op.import.undoPreview": {
      "description": "预览可撤销的变更、后续改动与权限不足的事件。",
      "x-timepin": {"scope":"calendar","access":"import-per-row","result":"undo"},
      "type":"object","required":["v","op","calendarId","batchId"],
      "properties":{"v":{"const":1},"op":{"const":"import.undoPreview"},"calendarId":{"$ref":"#/$defs/id"},"batchId":{"$ref":"#/$defs/id"}},"additionalProperties":false
    },
    "op.import.undo": {
      "description": "在当前权限与版本下撤销一批导入，保护后来的修改。",
      "x-timepin": {"scope":"calendar","access":"import-per-row","result":"undo"},
      "type":"object","required":["v","op","calendarId","operationId","batchId"],
      "properties":{"v":{"const":1},"op":{"const":"import.undo"},"calendarId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},"batchId":{"$ref":"#/$defs/id"}},"additionalProperties":false
    },
    "undoItem": {
      "type":"object","required":["eventId","outcome","version"],"additionalProperties":false,
      "properties":{"eventId":{"$ref":"#/$defs/id"},"outcome":{"enum":["restored","removed","changed","forbidden"]},"version":{"type":"integer","minimum":1}}
    },
    "instance": {
      "type": "object",
      "required": ["eventId", "on", "title", "color", "span", "version"],
      "properties": {
        "eventId": {"$ref": "#/$defs/id"},
        "on": {"$ref": "#/$defs/date"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "color": {"$ref": "#/$defs/color"},
        "span": {"$ref": "#/$defs/span"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    },
    "rowResult": {
      "type": "object",
      "required": ["index", "eventId", "baseVersion", "outcome"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "baseVersion": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "eventId": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "outcome": {"enum": ["created", "updated", "unchanged", "conflict", "forbidden"]}
      },
      "additionalProperties": false
    },
    "reply": {
      "oneOf": [
        {"type":"object","required":["code","batchId","undo"],"additionalProperties":false,"properties":{"code":{"const":"ok"},"batchId":{"$ref":"#/$defs/id"},"undo":{"type":"array","items":{"$ref":"#/$defs/undoItem"}}}},
        {
          "type": "object",
          "required": ["code", "record"],
          "properties": {"code": {"const": "ok"}, "record": {"$ref": "#/$defs/record"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "occurrences"],
          "properties": {"code": {"const": "ok"}, "occurrences": {"type": "array", "items": {"$ref": "#/$defs/instance"}}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "rows"],
          "properties": {
            "code": {"const": "ok"},
            "rows": {"type": "array", "items": {"$ref": "#/$defs/rowResult"}},
            "batchId": {"$ref": "#/$defs/id"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["code", "detail"],
          "properties": {
            "code": {
              "enum": ["invalid", "forbidden", "not_found", "conflict", "operation_reused", "window_too_dense"]
            },
            "detail": {"type": "string"},
            "current": {"$ref": "#/$defs/record"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
